# Set these environment variables before starting server.js to enable the College Connect administrator account.
CC_ADMIN_EMAIL=admin@example.com
CC_ADMIN_PASSWORD=replace-with-a-strong-password

# Server-side only. Use a Supabase Secret API key (sb_secret_...), never a publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
